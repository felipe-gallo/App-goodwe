{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "lib": ["ESNext", "DOM"],
    "moduleSuffixes": [".native", ".web", ""],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
